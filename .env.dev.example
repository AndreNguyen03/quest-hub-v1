# ── QuestHub · môi trường DEV ──────────────────────────────────────────
# Dev chạy hoàn toàn local bằng docker compose (xem Makefile: make dev-up).
# Cách dùng:  cp .env.dev.example .env
# Không commit giá trị thật — mọi secret thật chỉ nằm trong CI secrets.

COMPOSE_PROJECT_NAME=questhub

# PostgreSQL
POSTGRES_USER=questhub
POSTGRES_PASSWORD=questhub
POSTGRES_DB=questhub
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Elasticsearch
ES_PORT=9200

# JWT (Spring Boot: app.security.jwt.*)
JWT_SECRET=questhub-dev-secret-change-me-questhub-dev-secret-0123456789abcdef
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P7D