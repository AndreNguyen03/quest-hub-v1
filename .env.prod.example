# ── QuestHub · môi trường PROD ─────────────────────────────────────────
# Prod = k3s cluster, deploy qua manual approval + ArgoCD GitOps
# (xem .github/workflows/deploy-prod.yml + infra/k8s/overlays/prod).
# Giá trị thật được inject qua CI secrets / Vault — file này chỉ là template.

NAMESPACE=questhub-prod
INGRESS_HOST=questhub.app

# Image tag thật sẽ được override bằng git SHA (immutable)
IMAGE_TAG=prod-latest

# Số replica chạy production
BACKEND_REPLICAS=3
AI_REPLICAS=2

# Infra (điền qua CI secrets / Vault, KHÔNG commit giá trị thật)
POSTGRES_PASSWORD=__CHANGE_ME__
JWT_SECRET=__CHANGE_ME__