# ── QuestHub · môi trường STAGING ──────────────────────────────────────
# Staging = k3s cluster, deploy tự động khi merge vào main
# (xem .github/workflows/deploy-staging.yml + infra/k8s/overlays/staging).
# Giá trị thật được inject qua CI secrets / Vault — file này chỉ là template.

NAMESPACE=questhub-staging
INGRESS_HOST=staging.questhub.app

# Image tag thật sẽ được workflow override bằng git SHA (immutable)
IMAGE_TAG=staging-latest

# Infra (điền qua CI secrets, KHÔNG commit giá trị thật)
POSTGRES_PASSWORD=__CHANGE_ME__
JWT_SECRET=__CHANGE_ME__